# Optional hardening and speed-ups for Hostinger (Apache / LiteSpeed).
# NOT YET TESTED on the client's hosting: upload to a staging subdomain first.
# Every block is wrapped in <IfModule> so a missing module is skipped rather than causing an error.

# Force HTTPS. (If hPanel's "Force HTTPS" switch is on, this is redundant but harmless.)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Browser caching. CSS/JS are not fingerprinted, so they get a short lifetime.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Never serve the form-handler source or the internal notes if they are uploaded by mistake
<IfModule mod_rewrite.c>
  RewriteRule ^worker/ - [F,L]
  RewriteRule ^README\.md$ - [F,L]
</IfModule>
